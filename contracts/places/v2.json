    "version": 2,
    "headerBytes": 32,
    "recordBytes": 68,
    "stringOffsetBase": 36,
    "stringOffsetStride": 4,
    "stringFields": [
      "sourceId",
      "name",
      "countryCode",
      "source",
      "featureCode",
      "nameEn",
      "nameNative",
      "nameTimelineText"
