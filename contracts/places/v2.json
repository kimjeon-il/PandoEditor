        "field": "name",
        "byteOffset": 40
      },
      {
        "field": "countryCode",
        "byteOffset": 44
      },
      {
        "field": "source",
        "byteOffset": 48
      },
      {
        "field": "featureCode",
        "byteOffset": 52
      },
      {
        "field": "nameEn",
        "byteOffset": 56
      },
      {
        "field": "nameNative",
        "byteOffset": 60
      },
      {
        "field": "nameTimelineText",
        "byteOffset": 64
      }
    ],
    "longitudeOffset": 0,
    "latitudeOffset": 8,
    "populationOffset": 16,
    "priorityOffset": 24,
    "minZoomOffset": 28,
    "kindOffset": 32,
    "timelineSerialization": "UTF-8 JSON string in the shared pool"
  },
  "domain": {
    "builtinIdFormat": "builtin:place:{source}:{sourceId}",
    "placeKinds": [
      "capital",
      "city",
      "region",
      "town",
      "mountain",
      "water",
      "custom"
    ],
    "languageOrder": [
      "ko",
      "en",
      "native"
    ],
    "defaultLanguages": {
      "ko": true,
      "en": false,
      "native": false
    },
    "maxNameTransitions": 16,
    "timelineDateFormats": [
      "fromYear integer",
      "fromDate YYYY-MM-DD"
    ],
    "duplicateNameComparison": "trim -> NFKC -> lower-case; first enabled language wins",
    "missingLanguagePolicy": "omit missing translation; never fabricate names from source country code",
    "languageTogglePolicy": "at least one enabled; reject an unchanged or all-disabled request",
    "nameFields": {
      "ko": "name",
      "en": "nameEn",
      "native": "nameNative"
    }
  },
  "display": {
    "webEstimatedBox": {
      "minimumWidth": 22,
      "textPadding": 16,
      "latinCharWidth": 8,
      "otherCharWidth": 11,
      "firstLineHeight": 19,
      "extraLineHeight": 14
    },
    "geometryNotice": "CSS-pixel heuristic, not native Qt font measurements",
    "collisionPolicy": "one atomic collision box per place, regardless of language count"
  },
  "limits": {
    "candidates": 1500,
    "layoutCandidates": 2048,
    "tileRecords": 512,
    "queryTiles": 96,
    "shardBytes": 524288,
    "cacheBytes": 25165824,
    "searchResults": 50,
    "retainedRecords": 256
  },
